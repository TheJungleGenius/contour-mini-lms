# Local Supabase (from `npx supabase status`, after `npm run db:start`).
# Use the "Publishable" key (sb_publishable_...). Never put the secret /
# service-role key here: the app doesn't need it, and NEXT_PUBLIC_* values
# are shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key
